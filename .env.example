# Copia este archivo como .env y pon tus valores. El archivo .env NUNCA se sube a git.

# ElevenLabs -> Developers -> API Keys
ELEVENLABS_API_KEY=

# Se llena solo en la Fase 2, cuando se crea el agente
ELEVENLABS_AGENT_ID=

# Se llena solo al crear el agente de seguimiento de domingo
# (.venv\Scripts\python agente\subir_agente.py --agente seguimiento)
ELEVENLABS_AGENT_ID_SEGUIMIENTO=

# Twilio -> Console -> Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Tu número de Twilio en formato +1XXXXXXXXXX
TWILIO_NUMERO=

# Se llena solo al registrar el número de Twilio en ElevenLabs
# (.venv\Scripts\python herramientas/registrar_numero.py)
ELEVENLABS_PHONE_NUMBER_ID=
