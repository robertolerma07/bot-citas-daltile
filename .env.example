# Copia este archivo como .env y pon tus valores. El archivo .env NUNCA se sube a git.

# ElevenLabs -> Developers -> API Keys
ELEVENLABS_API_KEY=

# Se llena solo en la Fase 2, cuando se crea el agente
ELEVENLABS_AGENT_ID=

# Se llena solo al crear el agente de seguimiento de domingo
# (.venv\Scripts\python agente\subir_agente.py --agente seguimiento)
ELEVENLABS_AGENT_ID_SEGUIMIENTO=

# Twilio -> Console -> Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Tu número de Twilio en formato +1XXXXXXXXXX
TWILIO_NUMERO=

# Se llena solo al registrar el número de Twilio en ElevenLabs
# (.venv\Scripts\python herramientas/registrar_numero.py)
ELEVENLABS_PHONE_NUMBER_ID=

# Correos del domingo de seguimiento (cuenta de Gmail dedicada al bot, con contraseña de aplicación)
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_PASSWORD=
# Correo de Roberto: recibe la copia de los avisos y el correo de control de cada ronda
CORREO_CONTROL=

# Página web del domingo (domingo/servir.py): contraseña única del equipo y secreto largo al azar
# para firmar la sesión (por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(48))")
PAGINA_PASSWORD=
PAGINA_SECRETO=
